# OpenAI — server-side only. Never prefix with NEXT_PUBLIC_.
# Leave empty to run the app in mock mode (canned streamed replies, no cost).
OPENAI_API_KEY=

# Optional: force mock mode even when a key is present.
# MOCK_AI=1

# Optional: override the model. Must support image input + the Responses API.
# OPENAI_MODEL=gpt-5.4-mini

# Public origin, used for canonical URLs, the sitemap and the social card.
# Vercel provides VERCEL_PROJECT_PRODUCTION_URL automatically; set this when
# deploying anywhere else (or when you want a custom domain in metadata).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
